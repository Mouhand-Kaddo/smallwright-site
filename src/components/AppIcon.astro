---
interface Props {
  app: 'builder' | 'worker';
  class?: string;
}

const glyphs = {
  builder: {
    background: 'var(--color-body)',
    path: 'M46,30 H62 A6,6 0 0 1 68,36 V72 A6,6 0 0 1 62,78 H46 A6,6 0 0 1 40,72 V36 A6,6 0 0 1 46,30 Z M50.1,43.08 L61.02,54 L50.1,64.92 L47.34,62.16 L56.07,54 L47.34,45.84 Z',
  },
  worker: {
    background: 'var(--color-bezel)',
    path: 'M46,30 H62 A6,6 0 0 1 68,36 V72 A6,6 0 0 1 62,78 H46 A6,6 0 0 1 40,72 V36 A6,6 0 0 1 46,30 Z M48.5,48.5 H59.5 V59.5 H48.5 Z',
  },
};

const { app, class: className } = Astro.props;
const glyph = glyphs[app];
---

<svg viewBox="0 0 108 108" class={className} aria-hidden="true">
  <rect width="108" height="108" rx="26" fill={glyph.background} />
  <path fill="var(--color-signal)" fill-rule="evenodd" d={glyph.path} />
</svg>
